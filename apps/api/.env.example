PORT=8787
DATABASE_PATH=shopfront.sqlite

# Leave unset for local dev — the API runs with APM disabled when these are empty.
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=

# Leave unset for local dev — user-lifecycle event writes no-op when this is empty.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# (ELASTIC_API_KEY is accepted as an alias.)
# Or, instead of an API key:
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Shared secret for /internal/* routes (coding-harness-facing). Required —
# /internal/insights and /internal/friction return 503 until this is set.
# Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# Only needed when Elasticsearch isn't configured: /internal/friction uses
# the Elastic-hosted Jina reranker (.jina-reranker-v3.5) by default.
JINA_API_KEY=
# Optional — defaults to jina-reranker-v3.5.
JINA_RERANK_MODEL=
