{
  "name": "@shopfront/deploy-hook",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Webhook a coding harness calls to submit a git ref for CI-gated deploy to a self-hosted Docker+SSH target.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  }
}
