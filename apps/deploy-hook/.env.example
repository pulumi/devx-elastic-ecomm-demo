DEPLOY_HOOK_PORT=8788

# Required — the service refuses to start without these.
# Generate a secret with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=
# The repo this webhook is allowed to deploy from (a URL git can clone —
# HTTPS with a deploy token, or an SSH remote this host has a key for).
DEPLOY_GIT_REMOTE=

# The self-hosted Docker target. The webhook points the Docker CLI at this
# host over SSH (DOCKER_HOST=ssh://user@host) to build and deploy — no
# registry needed. The host needs: Docker installed, and this webhook's
# machine needs SSH key access to DEPLOY_SSH_USER@DEPLOY_SSH_HOST.
DEPLOY_SSH_USER=
DEPLOY_SSH_HOST=
DEPLOY_SSH_PORT=

# Optional — curled (with retries) after `docker compose up` to confirm the
# deploy actually came up before the job is marked succeeded.
DEPLOY_HEALTHCHECK_URL=
