{
  "_meta": {
    "description": "Index template for the user-lifecycle-events-* data stream. One document per funnel-stage event (session start, product view, cart add, checkout, order complete), so product can see how the funnel differs between human and agent/bot traffic once joined against traffic-classification-* by session.id. Owned jointly by the elastic-instrumentation and traffic-classification workstreams.",
    "owner": "workstream-4-5",
    "fields": {
      "event.action": "session_start | product_viewed | added_to_cart | checkout_started | order_completed",
      "traffic.request_kind": "api | page",
      "traffic.actor": "Coarse label: human | agent | bot",
      "traffic.classification": "human | agent-known | agent-suspected | bot-confirmed | bot-suspected",
      "traffic.agent_name": "Declared (X-Agent-Name / Signature-Agent) or UA-derived agent product name",
      "traffic.ground_truth": "Synthetic traffic only: the persona that generated the request (X-Synthetic-Persona). Never used by the classifier; used to score it.",
      "traffic.signals.ua_class": "browser | agent | bot | tool | empty",
      "traffic.signals.rate": "Requests in this session over the trailing 60s"
    }
  },
  "index_patterns": [
    "user-lifecycle-events-*"
  ],
  "data_stream": {},
  "priority": 200,
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "session": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "client": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "action": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            }
          }
        },
        "product": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "qty": {
              "type": "integer"
            }
          }
        },
        "order": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "total_cents": {
              "type": "long"
            }
          }
        },
        "traffic": {
          "properties": {
            "request_kind": {
              "type": "keyword"
            },
            "actor": {
              "type": "keyword"
            },
            "classification": {
              "type": "keyword"
            },
            "confidence": {
              "type": "float"
            },
            "agent_name": {
              "type": "keyword"
            },
            "reason": {
              "type": "keyword"
            },
            "ground_truth": {
              "type": "keyword"
            },
            "signals": {
              "properties": {
                "ua_class": {
                  "type": "keyword"
                },
                "declared_agent": {
                  "type": "boolean"
                },
                "rum_present": {
                  "type": "boolean"
                },
                "sec_fetch_present": {
                  "type": "boolean"
                },
                "session_header_present": {
                  "type": "boolean"
                },
                "rate": {
                  "type": "float"
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "index.default_pipeline": "traffic-classification"
    }
  }
}
